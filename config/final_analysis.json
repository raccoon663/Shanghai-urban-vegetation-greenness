    "active_months": [3, 4, 5, 6, 7, 8, 9, 10, 11],
    "summer_months": [7, 8],
    "autumn_months": [9, 10, 11],
    "minimum_patch_year_observations": 15,
    "minimum_summer_observations": 3,
    "maximum_active_season_gap_days": 45,
    "minimum_clear_sample_points": 2,
    "sentinel2_baseline_offset_start": "2022-01-25",
    "sentinel2_new_baseline_reflectance_offset": 0.1,
    "landsat_s2_calibration_window_days": 3,
    "calibration_instability_absolute_slope_difference": 0.15,
    "calibration_instability_rmse_ratio": 1.5,
    "annual_landcover_collection": "io-lulc-annual-v02",
    "annual_landcover_available_years": [2017, 2018, 2019, 2020, 2021, 2022, 2023],
    "annual_landcover_missing_year_rule": "flag uncertain_no_annual_map and retain unless a prior sustained probable conversion was observed",
    "annual_landcover_conversion_persistence_years": 2,
    "landcover_probable_conversion_built_fraction": 0.6666666667,
    "landcover_probable_conversion_max_vegetation_fraction": 0.3333333333,
    "hot_year_rule": "upper tercile of annual Shanghai-wide median summer Landsat LST across the 25 blocks",
    "cool_year_rule": "lower tercile of annual Shanghai-wide median summer Landsat LST across the 25 blocks",
    "temporal_heterogeneity_effect_range_threshold": 0.10,
    "block_bootstrap_replicates": 1000,
    "effect_contrast_built_levels": [0.05, 0.30, 0.75]
  },
  "replication": {
    "years": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025],
    "primary_endpoint": "summer_NDVI",
    "second_confirmatory_endpoint": "peak_NDVI",
    "primary_built_radius_m": 1000,
    "replication_target_blocks_min": 10,
    "replication_target_blocks_max": 20,
    "replication_block_size_m": 5000,
    "minimum_block_separation_m": 6000,
    "validation_confidence_inclusion": ["HIGH", "MEDIUM"],
    "calibration_windows_days": [0, 1, 3],
