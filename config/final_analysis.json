{
  "project": "shanghai_urban_vegetation_greenness",
  "random_seed": 42,
  "years": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025],
  "analysis_crs": "EPSG:32651",
  "display_crs": "EPSG:4326",
  "block_size_m": 5000,
  "original_design_blocks": 25,
  "replication_new_blocks": 15,
  "primary_endpoint": "summer_NDVI",
